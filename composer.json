{
    "name": "stackin-io/stackin-php-sdk",
    "description": "Official PHP SDK for the stackin fiscal document API — issue, consult, cancel NF-e and NFS-e.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.stackin.io",
    "keywords": [
        "nfe",
        "nfse",
        "nota-fiscal",
        "nota-fiscal-eletronica",
        "invoice",
        "fiscal-document",
        "brazil",
        "sefaz",
        "e-invoicing"
    ],
    "support": {
        "issues": "https://github.com/stackin-io/stackin-php-sdk/issues",
        "source": "https://github.com/stackin-io/stackin-php-sdk",
        "docs": "https://docs.stackin.io/blog/php-sdk"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Stackin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stackin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "lint": "phpcs --standard=.code_quality/phpcs.xml",
        "analyse": "phpstan analyse -c .code_quality/phpstan.neon"
    }
}
